# Copy this file to `server/.env` and fill in your values.
# `server/.env` is gitignored — never commit real keys.

# Riot API key — powers "Import from Riot ID", profile and scouting.
# Get one at https://developer.riotgames.com (dev keys expire every 24h).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Port the proxy listens on (Railway/Render inject PORT automatically)
PORT=3001

# Only allow requests from your deployed frontend.
# During local dev, leave as * or set to http://localhost:4200
ALLOWED_ORIGIN=*
